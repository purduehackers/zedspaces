{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zs.example.com/contracts/sandbox-manifest.v1.json",
  "title": "SandboxManifest v1",
  "description": "The manifest `GET {ZS_CONTROL_URL}/sandboxes/{name}/manifest` returns to `zs-agent` (b8 §3.4, §4.1; b9 §4.7; D19). Unknown fields are ignored by the supervisor for forward compatibility, so this schema does not forbid additional properties. Rules that need the sandbox environment (identity, `workspaceDir` under `ZS_WORKSPACES_DIR`, `forwards[].slot` in `ZS_PROXY_SLOTS`) are enforced by `Manifest::validate`, not here.",
  "type": "object",
  "required": [
    "version",
    "workspaceId",
    "sandboxName",
    "userId",
    "build",
    "region",
    "repo",
    "workspaceDir",
    "jwt",
    "portSessionSecret",
    "idle",
    "session"
  ],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "workspaceId": { "type": "string", "minLength": 1 },
    "sandboxName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sandboxGeneration": { "type": "integer", "minimum": 1 },
    "userId": { "type": "string", "minLength": 1 },
    "build": { "type": "string", "minLength": 1 },
    "clientBuild": { "type": "string", "minLength": 1, "description": "workspaces.client_build; the build string the server accepts in Hello (D23/D26). Absent means client and server share ZS_BUILD_ID." },
    "region": { "type": "string" },
    "repo": {
      "type": "object",
      "required": ["owner", "name", "cloneUrl", "defaultBranch", "revision"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "cloneUrl": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 0 },
        "ref": { "type": ["string", "null"] }
      }
    },
    "workspaceDir": { "type": "string", "pattern": "^/" },
    "restore": {
      "type": ["object", "null"],
      "required": ["tarballUrl"],
      "properties": {
        "tarballUrl": { "type": "string", "pattern": "^https?://" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "dotfiles": {
      "type": ["object", "null"],
      "required": ["repoUrl"],
      "properties": {
        "repoUrl": { "type": "string", "minLength": 1 },
        "installCommand": { "type": ["string", "null"] }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secretNames": { "type": "array", "items": { "type": "string" } },
    "jwt": {
      "type": "object",
      "required": ["issuer", "audience", "publicKeys"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "publicKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "-----BEGIN PUBLIC KEY-----" }
        },
        "portAudience": { "type": "string" }
      }
    },
    "portSessionSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "description": "Standard base64 (padded) of exactly 32 bytes."
    },
    "proxySlots": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "forwards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["port", "visibility"],
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "visibility": { "type": "string", "enum": ["public", "private"] },
          "label": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "slot": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "portPool": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "idle": {
      "type": "object",
      "required": ["minutes"],
      "properties": { "minutes": { "type": "integer", "minimum": 1 } }
    },
    "session": {
      "type": "object",
      "required": ["id", "startedAt", "capAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "integer", "minimum": 0 },
        "capAt": { "type": "integer", "minimum": 0 },
        "resumed": { "type": "boolean" }
      }
    },
    "devcontainer": {
      "description": "b10 §4.4, D38: authoritative for the supervisor when `source` is `manifest`; a control plane that sends only `configHash` parses as `source: checkout` and the supervisor reads the checkout. The full block is `manifest-devcontainer.v1.json` (generated from the zod schema); this inline copy uses only the constructs `Manifest::validate`'s checker understands.",
      "type": ["object", "null"],
      "required": ["configHash"],
      "properties": {
        "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "imageBuildId": { "type": "string" },
        "source": { "type": "string", "enum": ["manifest", "checkout"] },
        "lifecycle": {
          "type": "object",
          "properties": {
            "onCreate": { "type": "object", "required": ["kind"] },
            "updateContent": { "type": "object", "required": ["kind"] },
            "postCreate": { "type": "object", "required": ["kind"] },
            "postStart": { "type": "object", "required": ["kind"] },
            "postAttach": { "type": "object", "required": ["kind"] }
          }
        },
        "remoteEnv": { "type": "object", "additionalProperties": { "type": "string" } },
        "forwardPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "portsAttributes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "visibility": { "type": "string", "enum": ["public", "private"] },
              "protocol": { "type": "string", "enum": ["http", "https"] },
              "onAutoForward": { "type": "string" }
            }
          }
        },
        "otherPortsAttributes": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "visibility": { "type": "string", "enum": ["public", "private"] }
          }
        },
        "zed": {
          "type": "object",
          "properties": {
            "extensions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" } },
            "settings": { "type": "object" },
            "prebuild": {
              "type": "object",
              "properties": {
                "files": { "type": "array", "items": { "type": "string" } },
                "command": { "type": "string" }
              }
            },
            "services": { "type": "array", "items": { "type": "string", "enum": ["dockerd"] } }
          }
        },
        "services": { "type": "array", "items": { "type": "string", "enum": ["dockerd"] } },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["common-utils", "node", "python", "go", "rust", "java", "docker-in-docker", "github-cli"]
          }
        }
      }
    },
    "settings": {
      "type": ["object", "null"],
      "required": ["settings", "keymap"],
      "properties": {
        "settings": { "type": "string" },
        "keymap": { "type": "string" }
      }
    },
    "logs": {
      "type": "object",
      "properties": {
        "flushIntervalSecs": { "type": "integer", "minimum": 1 },
        "maxBatch": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxBatchBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    },
    "activity": {
      "type": "object",
      "properties": { "intervalSecs": { "type": "integer", "minimum": 10 } }
    },
    "allowedOrigins": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https?://[^/?#]+$" }
    },
    "extensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
    },
    "prebuild": {
      "type": ["object", "null"],
      "required": ["id", "branch", "commit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
