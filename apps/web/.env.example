# Deployment template — apps/web is the Vercel project root.
# No login, Clerk, GitHub App/token, Postgres or Redis credentials.
# Local development: use pnpm dev:local; it supplies a dedicated SQLite file and local keys.
# Never copy its generated .zs-dev keys into a deployment.

# One persistent Turso database for control state, locks, rate limits, and KV.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=
# Run pnpm db:migrate explicitly with this database before deploying.

# Canonical public origin plus /api; Sandbox callbacks must be able to reach it.
ZS_CONTROL_URL=https://YOUR-DOMAIN/api

# Generate fresh material with pnpm zs:keygen (store securely; never commit).
ZS_JWT_PRIVATE_KEY=
ZS_JWT_KID=k1
ZS_JWT_ISSUER=zs
ZS_EDITOR_COOKIE_SECRET=
CRON_SECRET=

# Matching production client and Linux server, never dev-* or *-test.
ZS_CLIENT_BUILD_ID=
ZS_SERVER_BUILD_ID=
# vcr.vercel.com/TEAM/PROJECT/workspace@sha256:...
ZS_IMAGE_REF=
# Base URL BEFORE /editor; fetches /editor/manifest.json and /editor/<build>.tar.
ZS_EDITOR_BUNDLE_SOURCE=
ZS_EDITOR_BUNDLES=
# Served builds with the web update bridge; release publication fills this in.
ZS_EDITOR_UPDATE_BUILDS=
ZS_EDITOR_BUNDLES_KEEP=5
ZS_CSP_UNSAFE_EVAL=1

# Real Vercel Sandbox. Its SDK uses Vercel OIDC automatically on Vercel.
ZS_SANDBOX_BACKEND=vercel
ZS_DEFAULT_REGION=iad1
ZS_MAX_RUNNING_WORKSPACES=5
ZS_IDLE_MINUTES_DEFAULT=30
ZS_RETENTION_DAYS=30
# Vercel Pro required for four-hour sessions and the minute sweep cron.
ZS_SESSION_TIMEOUT_MS=14400000
ZS_SESSION_CAP_MS=86400000
# Only needed if preview deployment protection is enabled:
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Private Vercel Blob: temporary file-preserving rebuild archives.
BLOB_READ_WRITE_TOKEN=
ZS_BLOB_DRIVER=vercel
