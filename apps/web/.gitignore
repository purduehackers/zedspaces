# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/test-results/
/out/

# production
/build
/release-record.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workflow devkit local state
.workflow-data/
.workflow-vitest/

# env example is committed
!.env.example

# generated by the Workflow DevKit next plugin
/app/.well-known/workflow/
/.swc/

# local backend dev keys and state (scripts/dev-local.sh)
/.zs-dev/

# editor bundles are fetched (scripts/fetch-editor-bundle.ts) or built (script/build-web), never
# committed; the dev-0 stub, the manifest and the README are
/public/editor/*
!/public/editor/.gitkeep
!/public/editor/README.md
!/public/editor/manifest.json
!/public/editor/dev-0/
